# Copy to .env.local (git-ignored) and fill in.

# ---------------------------------------------------------------------------
# Backend adapter
# ---------------------------------------------------------------------------
# mock = seeded, in-browser, runs the whole demo offline (the default and the
#        insurance policy). live = the Python orchestrator.
NEXT_PUBLIC_MP_SOURCE=mock
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------------------------------------------------------------------------
# /intake — the Groq tiers
# ---------------------------------------------------------------------------
# SERVER ONLY. No NEXT_PUBLIC_ prefix, so this is never inlined into a client
# bundle — it is read exclusively by the route handlers under app/api/intake/.
#
# Everything in /intake works WITHOUT this key: branch classification falls
# back to the offline keyword table, option matching falls back to
# "please pick one below", and red flags still fire from the deterministic
# tier A phrase table. The key buys the exception paths, not the safety net.
#
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Two models, picked from Backend/MediPilot/Metrics/structurer_bakeoff_table.md:
#   gpt-oss-120b  F1 0.962, 0 red flags missed  -> observation extraction
#   gpt-oss-20b   F1 0.816, 4 red flags missed  -> matching + classification
# MEDIPILOT_GROQ_MODEL_FAST=openai/gpt-oss-20b
# MEDIPILOT_GROQ_MODEL_OBSERVE=openai/gpt-oss-120b

# Rehearsal switch: forces every Groq call to behave as if the network were
# down, so a demo can be walked repeatedly without burning free-tier quota.
# MEDIPILOT_INTAKE_OFFLINE=1
