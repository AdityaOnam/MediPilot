# Generated training data — regenerate with:
#   python -m data.generator.bulk --n 20000 --seed 1337 --out data/train_set.jsonl
# Half a gigabyte of synthetic trajectories has no business in version control;
# the generator + seed + config/label_spec.yaml fully determine it.
data/train_set.jsonl
data/*.jsonl
data/*.meta.json

# Model artifacts ARE committed (a few MB) so the fallback path is exercised
# with a real artifact present, but the held-out split dump is regenerable.
model/artifacts/**/test_split.npz

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
