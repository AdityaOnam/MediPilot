# Copy to .env (git-ignored) and fill in, or set these in your shell.
#
# ---------------------------------------------------------------------------
# The deployment position
# ---------------------------------------------------------------------------
# Local inference is the destination; hosted free-tier APIs are the fallback.
# Under DPDP 2023 and §13 ("raw patient data stays at the institution"), a
# model running inside the hospital is the architecture the plan commits to —
# not a cost optimisation. Both chains below are therefore local-first, and
# GET /v1/config reports which one is actually serving, so the system never
# makes a privacy claim it is not currently honouring.
#
# See DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Hosted fallback credential (free tier)
# ---------------------------------------------------------------------------
# One key covers both stages: Groq serves the hosted Whisper used by M05
# (speech/groq_asr.py) and the LLM used by M06 (intake/llm_structurer.py).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# M05 — speech
# ---------------------------------------------------------------------------
# Comma-separated preference order; the first that can be built wins.
#   local   — faster-whisper (CTranslate2 int8). No network, no key, no audio
#             leaves the machine. Needs requirements-speech-local.txt.
#   whisper — openai-whisper in-process. For bake-offs; CPU-only on AMD.
#   groq    — hosted whisper-large-v3-turbo.
#   off     — refuse transcription (typed-only run).
# MEDIPILOT_ASR_BACKEND=local,groq

# Whisper model. Local: tiny|base|small|medium|large-v3 (and turbo for the
# `whisper` backend). Hosted: whisper-large-v3-turbo|whisper-large-v3.
# Pick this from eval/kaggle/asr_bakeoff.ipynb results, not from the default.
# MEDIPILOT_WHISPER_MODEL=small
# MEDIPILOT_WHISPER_COMPUTE_TYPE=int8      # int8 | int8_float16 | float16

# ---------------------------------------------------------------------------
# M06 — LLM structurer
# ---------------------------------------------------------------------------
#   local — any OpenAI-compatible server: Ollama, llama.cpp's llama-server,
#           LM Studio, vLLM.
#   groq  — hosted, JSON-schema-constrained.
#   rules — RuleBasedStructurer: deterministic keywords, explicitly NOT an
#           LLM. The floor; reported as such and never passed off as one.
# MEDIPILOT_STRUCTURER=local,groq,rules

# MEDIPILOT_LOCAL_LLM_URL=http://localhost:11434/v1   # Ollama default
# MEDIPILOT_LOCAL_LLM_MODEL=qwen2.5:3b-instruct
# MEDIPILOT_STRUCTURER_MODEL=openai/gpt-oss-20b       # the hosted one
