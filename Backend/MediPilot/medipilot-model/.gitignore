# Generated training data — regenerate with:
#   python -m data.generator.bulk --n 20000 --seed 1337 --out data/train_set.jsonl
# Half a gigabyte of synthetic trajectories has no business in version control;
# the generator + seed + config/label_spec.yaml fully determine it.
data/train_set.jsonl
data/*.jsonl
data/*.meta.json

# Model artifacts ARE committed (a few MB) so the fallback path is exercised
# with a real artifact present, but the held-out split dump is regenerable.
model/artifacts/**/test_split.npz

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Perception layer: the API key lives here and must never be committed.
.env

# Bake-off outputs. Regenerate with:
#   python -m eval.run_asr_bakeoff --backends groq --out <path>
#   python -m eval.run_structurer_bakeoff --candidates groq --out <path>
# The eval SETS (eval/*.json manifests and cases) are committed; the RESULTS
# are not, because they are machine- and date-specific and quoting a stale one
# in the report is worse than having none.
eval/results/
*_bakeoff_results.json
*_bakeoff_table.md
asr_reference_template.json
